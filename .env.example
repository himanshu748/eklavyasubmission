VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Supabase Edge Function secret, set in Supabase rather than in Vite:
# LOVABLE_API_KEY=your_lovable_gateway_key

# Optional Supabase Edge Function CORS allowlist:
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.example.com
